# Sherpa — environment variables
#
# Copy to `.env` (or `.env.local`) at the repo root. The `.env*` files are
# git-ignored except for this template. The single source of truth for
# anything Sherpa reads from `process.env` is `packages/config/src/index.ts`
# via `loadConfig()`. Do not read `process.env` directly anywhere else.
#
# When adding any of these to Vercel, mark them sensitive at add-time —
# Vercel will not let you toggle that later without re-creating the var.
# See `docs/sherpa/SHERPA_FREE_TIER_GUIDE.md` for free-tier signup notes.

# ---------- Chain selection ----------
# `base-sepolia` (default, used through Stage 4) or `base-mainnet`. Anything
# else falls back to base-sepolia. See packages/config/src/index.ts.
SHERPA_CHAIN=base-sepolia

# Optional override for the chain's default RPC URL (e.g. an Alchemy or
# Coinbase Cloud endpoint). Leave blank to use the public endpoint baked
# into CHAINS[SHERPA_CHAIN].rpcUrl.
SHERPA_RPC_URL=

# `false` disables real RPC reads (used in unit tests / offline dev).
# Anything other than the literal string "false" enables real RPC.
SHERPA_USE_REAL_RPC=false

# Coinbase Paymaster service URL (EIP-5792 capabilities.paymasterService.url).
# Leave blank to skip sponsorship and surface gas in the confirmation card.
SHERPA_PAYMASTER_URL=

# ---------- LLM provider keys ----------
# At least one of these must be set for the LLM router to operate. Order of
# preference is configured in packages/llm/src/router.ts. The router falls
# back across providers on rate-limit / 5xx; missing keys are treated as
# "provider unavailable" rather than a hard error.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ---------- External data ----------
# Basescan API key for the history indexer (packages/tools/src/basescan.ts
# and apps/api /history). Free tier is sufficient through Stage 1.
BASESCAN_API_KEY=

# ---------- Server / wiring ----------
# apps/api (Fastify) bind config. Defaults are 0.0.0.0:3001.
HOST=0.0.0.0
PORT=3001

# apps/web reverse-proxies /api/* to this base URL via next.config.mjs.
# Only needed if the API is not at http://localhost:3001 in dev.
SHERPA_API_BASE=http://localhost:3001

# Human-run M3 smoke target. Defaults to localhost in @sherpa/config;
# override for Preview/Production smoke runs.
SMOKE_API_URL=http://localhost:3001

# ---------- Database (M3 — Postgres-backed memory) ----------
# Flip to `true` to use Supabase Postgres for audit_log + llm_usage. Default
# `false` keeps the in-memory stores (tests, local dev). Validated by zod in
# packages/config/src/index.ts.
SHERPA_USE_REAL_DB=false

# Supabase transaction-mode pooler URL (port 6543). Required when
# SHERPA_USE_REAL_DB=true. Mark sensitive in Vercel.
DATABASE_URL=

# Supabase service role key (server-side only). Mark sensitive in Vercel.
SUPABASE_SERVICE_KEY=

# ---------- Identity resolvers (M3 Priority 2) ----------
# Neynar Farcaster API key. Free tier ~5k req/day. Mark sensitive in Vercel.
# Sign up at https://neynar.com.
NEYNAR_API_KEY=
NEYNAR_BASE_URL=https://api.neynar.com

# Ethereum mainnet RPC for ENS resolution. Use an Alchemy / Infura URL when
# possible; we fall back to ethereum.publicnode.com (rate-limited) when blank.
ALCHEMY_ETH_MAINNET_RPC=

# ---------- Vercel KV (identity cache layer + future rate limiter) ----------
# Auto-injected when the KV integration is connected to the Vercel project.
# When unset, the in-memory LRU is the only cache layer (still fine for dev).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------- Admin endpoints (LLM cost reporting) ----------
# Bearer token for /admin/llm-usage/*. 64 lowercase hex chars. Generate with:
#   openssl rand -hex 32
# When unset, /admin/* responds 503 (route disabled, not mis-authed).
# Admin routes also require SHERPA_USE_REAL_DB=true — without Postgres there
# is no `llm_usage` table to read.
ADMIN_API_KEY=

# ---------- Sentry (error reporting) ----------
# SENTRY_DSN — sensitive — sentry.io free Developer plan covers 5k errors/mo,
# enough through Stage 1. When unset, error reporting is a no-op (logs still
# go to stdout/stderr).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---------- Cron (cron-job.org → /api/cron/hourly) ----------
# Bearer token validating incoming hourly hits. 64 lowercase hex chars.
# Generate with: openssl rand -hex 32
# When unset, /api/cron/* responds 503 (route disabled).
# See docs/sherpa/setup/CRON_JOB_ORG_SETUP.md.
CRON_SECRET=

# ---------- Background worker (Railway @sherpa/worker) ----------
# The worker runs alert evaluation, DCA checks, and auto-repay checks against
# the same Postgres stores as the API when SHERPA_USE_REAL_DB=true.
# Disable individual loops only during incident response or focused testing.
WORKER_ALERTS_ENABLED=true
WORKER_DCA_ENABLED=true
WORKER_AUTO_REPAY_ENABLED=true

# Loop intervals in milliseconds. Keep >= 60s in production to avoid noisy
# RPC/API usage on the free tiers.
ALERT_INTERVAL_MS=60000
DCA_INTERVAL_MS=60000
AUTO_REPAY_INTERVAL_MS=60000
