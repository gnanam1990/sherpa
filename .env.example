# Sherpa — environment variables
#
# Copy to `.env` (or `.env.local`) at the repo root. The `.env*` files are
# git-ignored except for this template. The single source of truth for
# anything Sherpa reads from `process.env` is `packages/config/src/index.ts`
# via `loadConfig()`. Do not read `process.env` directly anywhere else.
#
# When adding any of these to Vercel, mark them sensitive at add-time —
# Vercel will not let you toggle that later without re-creating the var.
# See `docs/sherpa/SHERPA_FREE_TIER_GUIDE.md` for free-tier signup notes.

# ---------- Chain selection ----------
# `base-sepolia` (default, used through Stage 4) or `base-mainnet`. Anything
# else falls back to base-sepolia. See packages/config/src/index.ts.
SHERPA_CHAIN=base-sepolia

# Optional override for the chain's default RPC URL (e.g. an Alchemy or
# Coinbase Cloud endpoint). Leave blank to use the public endpoint baked
# into CHAINS[SHERPA_CHAIN].rpcUrl.
SHERPA_RPC_URL=

# `false` disables real RPC reads (used in unit tests / offline dev).
# Anything other than the literal string "false" enables real RPC.
SHERPA_USE_REAL_RPC=false

# Coinbase Paymaster service URL (EIP-5792 capabilities.paymasterService.url).
# Leave blank to skip sponsorship and surface gas in the confirmation card.
SHERPA_PAYMASTER_URL=

# ---------- LLM provider keys ----------
# At least one of these must be set for the LLM router to operate. Order of
# preference is configured in packages/llm/src/router.ts. The router falls
# back across providers on rate-limit / 5xx; missing keys are treated as
# "provider unavailable" rather than a hard error.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ---------- External data ----------
# Basescan API key for the history indexer (packages/tools/src/basescan.ts
# and apps/api /history). Free tier is sufficient through Stage 1.
BASESCAN_API_KEY=

# ---------- Server / wiring ----------
# apps/api (Fastify) bind config. Defaults are 0.0.0.0:3001.
HOST=0.0.0.0
PORT=3001

# apps/web reverse-proxies /api/* to this base URL via next.config.mjs.
# Only needed if the API is not at http://localhost:3001 in dev.
SHERPA_API_BASE=http://localhost:3001
