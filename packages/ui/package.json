{
  "name": "@sherpa/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React components + design tokens. (owner: M2)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "react": "^19.0.0",
    "wagmi": "^2.0.0"
  },
  "devDependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7",
    "wagmi": "^2.0.0"
  }
}
