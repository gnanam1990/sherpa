{
  "name": "@sherpa/config",
  "version": "0.0.0",
  "private": true,
  "description": "Env validation and chain configs. (owner: M3)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "pg": "^8.20.0",
    "zod": "^3.23.8"
  }
}
