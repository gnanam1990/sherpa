{
  "name": "@sherpa/tools",
  "version": "0.0.0",
  "private": true,
  "description": "Protocol adapters (quote/buildTx/verify). (owner: M1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@sherpa/safety": "workspace:*",
    "viem": "^2.21.54",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
