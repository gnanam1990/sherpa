# Create this in Telegram with @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Production Sherpa API. Required for /parse, /balance, /history, /positions, and signing links.
SHERPA_API_BASE=https://sherpaapi-production.up.railway.app
SHERPA_WEB_BASE=https://sherpa-web.vercel.app

# Comma-separated numeric Telegram user IDs allowed during private beta.
# Get yours from @userinfobot or @RawDataBot.
ADMIN_TG_USER_IDS=

# Keep mainnet-write Stage 2 flows disabled. Testnet write demos can be enabled explicitly.
SHERPA_STAGE_2_TESTNET_ENABLED=false
NEXT_PUBLIC_SHERPA_STAGE_2_ENABLED=false

# Stage 2 Base Sepolia contracts — testnet audit target, not mainnet
SHERPA_ROUTER_BASE_SEPOLIA=0xDfe689ec2f0Ae3635C372DfaB7b6581bBb7c4032
SHERPA_TREASURY_BASE_SEPOLIA=0x70A58169BF96587E55F500c4b5cb9d956Ef826ee
