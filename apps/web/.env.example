# WalletConnect Project ID — cloud.reown.com (free)
NEXT_PUBLIC_WC_PROJECT_ID=

# Coinbase Developer Platform — portal.cdp.coinbase.com (free)
NEXT_PUBLIC_CDP_PROJECT_ID=

# Base.dev Builder Code — dashboard.base.org (public attribution code, not a secret)
NEXT_PUBLIC_BUILDER_CODE=

# Paymaster URL is server-side only. See apps/api/.env.example
# for SHERPA_PAYMASTER_RPC. Web calls /api/paymaster proxy.

# Sentry — error monitoring (leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Stage 2 feature flags
NEXT_PUBLIC_SHERPA_STAGE_2_ENABLED=false

# Stage 2 Base Sepolia contracts — testnet reference deployment
NEXT_PUBLIC_SHERPA_ROUTER_BASE_SEPOLIA=0xDfe689ec2f0Ae3635C372DfaB7b6581bBb7c4032
NEXT_PUBLIC_SHERPA_TREASURY_BASE_SEPOLIA=0x70A58169BF96587E55F500c4b5cb9d956Ef826ee

# Stage 2 Base mainnet contracts — deployed, verified, and shown when public Stage 2 is enabled.
NEXT_PUBLIC_SHERPA_ROUTER_BASE_MAINNET=0x00bfef87DD352D48F8572BcfA52E57870B35DE8b
NEXT_PUBLIC_SHERPA_TREASURY_BASE_MAINNET=0xF4e72beAA559E1815f4671e39EDb1295aD975918
