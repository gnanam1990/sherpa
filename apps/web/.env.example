# WalletConnect Project ID — cloud.reown.com (free)
NEXT_PUBLIC_WC_PROJECT_ID=

# Coinbase Developer Platform — portal.cdp.coinbase.com (free)
NEXT_PUBLIC_CDP_PROJECT_ID=

# Base.dev Builder Code — dashboard.base.org (public attribution code, not a secret)
NEXT_PUBLIC_BUILDER_CODE=

# Paymaster URL is server-side only. See apps/api/.env.example
# for SHERPA_PAYMASTER_RPC. Web calls /api/paymaster proxy.

# Sentry — error monitoring (leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
