# apps/api environment

# Coinbase Paymaster RPC URL — from CDP → Paymaster policy
# Sensitive: server-side only, never proxy in NEXT_PUBLIC_*
# See: docs/sherpa/decisions/2026-05-15-paymaster-proxy.md
SHERPA_PAYMASTER_RPC=

# Tenderly — transaction simulation (Stage 2)
# See: docs/sherpa/decisions/2026-05-15-tenderly-simulation.md
# Get these from https://dashboard.tenderly.co/account/xxx/project/xxx/settings
TENDERLY_API_KEY=
TENDERLY_USER=
TENDERLY_PROJECT=
# Set to 'false' to disable simulation entirely (default: true)
# SHERPA_SIMULATION_ENABLED=true

# Aave V3 — LEND/BORROW/REPAY/WITHDRAW intent (Stage 2)
# See: docs/sherpa/decisions/2026-05-15-lend-intent-aave.md
# Base mainnet Pool proxy address. Keep unset in local/offline test environments.
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
AAVE_DATA_PROVIDER_ADDRESS=

# Read-only Aave positions route (safe without Stage 2 audit)
# Defaults to https://mainnet.base.org when unset.
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# === MAINNET CONFIGURATION (Stage 2 P6) ===
# Set SHERPA_CHAIN=base-mainnet to flip to mainnet
# SHERPA_CHAIN=base-sepolia

# Required on mainnet:
# AERODROME_ROUTER_ADDRESS=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
# AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# SHERPA_FEE_TREASURY_ADDRESS=
# SHERPA_FEE_ENABLED=true
# SHERPA_FEE_BPS=10

# Sherpa web app base URL (used in sign-intent links for surfaces)
SHERPA_WEB_BASE=https://sherpa-web.vercel.app

# Stage 2 feature flags
SHERPA_STAGE_2_ENABLED=false
# Set true only when Base mainnet Stage 2 writes should be public for any connected wallet.
SHERPA_STAGE_2_PUBLIC_MAINNET=false
# Optional comma-separated wallet allowlist for guarded Base mainnet Stage 2 rollout.
# Used only while SHERPA_STAGE_2_PUBLIC_MAINNET=false.
SHERPA_STAGE_2_BETA_WALLETS=
# Testnet-only Stage 2 demos on Base Sepolia (swap/lend/borrow).
SHERPA_STAGE_2_TESTNET_ENABLED=true

# Stage 2 Base Sepolia contracts — testnet reference deployment
SHERPA_ROUTER_BASE_SEPOLIA=0xDfe689ec2f0Ae3635C372DfaB7b6581bBb7c4032
SHERPA_TREASURY_BASE_SEPOLIA=0x70A58169BF96587E55F500c4b5cb9d956Ef826ee

# Stage 2 Base mainnet contracts — deployed, verified, and used when
# SHERPA_STAGE_2_ENABLED=true with either public mainnet or a beta wallet.
SHERPA_ROUTER_BASE_MAINNET=0x00bfef87DD352D48F8572BcfA52E57870B35DE8b
SHERPA_TREASURY_BASE_MAINNET=0xF4e72beAA559E1815f4671e39EDb1295aD975918
AERODROME_FACTORY_ADDRESS=0x420DD381b31aEf6683db6B902084cB0FFECe40Da

# Notification delivery
# Email alerts use Resend first, then Postmark. Missing provider keys produce
# `email_channel_not_configured` instead of fake success.
RESEND_API_KEY=
POSTMARK_API_KEY=
EMAIL_FROM_ADDRESS=Sherpa <alerts@sherpa-web.vercel.app>

# Browser push alerts. Generate VAPID keys with:
#   pnpm --filter @sherpa/tools exec web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:alerts@sherpa-web.vercel.app
