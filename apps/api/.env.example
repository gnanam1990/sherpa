# apps/api environment

# Coinbase Paymaster RPC URL — from CDP → Paymaster policy
# Sensitive: server-side only, never proxy in NEXT_PUBLIC_*
# See: docs/sherpa/decisions/2026-05-15-paymaster-proxy.md
SHERPA_PAYMASTER_RPC=

# Tenderly — transaction simulation (Stage 2)
# See: docs/sherpa/decisions/2026-05-15-tenderly-simulation.md
# Get these from https://dashboard.tenderly.co/account/xxx/project/xxx/settings
TENDERLY_API_KEY=
TENDERLY_USER=
TENDERLY_PROJECT=
# Set to 'false' to disable simulation entirely (default: true)
# SHERPA_SIMULATION_ENABLED=true

# Aave V3 — LEND intent (Stage 2 Priority 3)
# See: docs/sherpa/decisions/2026-05-15-lend-intent-aave.md
# Pool proxy address on Base Sepolia — confirm from https://aave.com/docs
# Currently unset on Sepolia (Aave Sepolia deployment pending) and mainnet
# (pending audit). LEND will be unavailable until set.
AAVE_POOL_ADDRESS=
AAVE_DATA_PROVIDER_ADDRESS=

# Read-only Aave positions route (safe without Stage 2 audit)
# Defaults to https://mainnet.base.org when unset.
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# === MAINNET CONFIGURATION (Stage 2 P6) ===
# Set SHERPA_CHAIN=base-mainnet to flip to mainnet
# SHERPA_CHAIN=base-sepolia

# Required on mainnet:
# AERODROME_ROUTER_ADDRESS=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
# AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# SHERPA_FEE_TREASURY_ADDRESS=
# SHERPA_FEE_ENABLED=true
# SHERPA_FEE_BPS=10

# Sherpa web app base URL (used in sign-intent links for surfaces)
SHERPA_WEB_BASE=https://sherpa-web.vercel.app

# Stage 2 feature flags — set to 'true' after audit completion
SHERPA_STAGE_2_ENABLED=false
# Testnet-only Stage 2 demos on Base Sepolia (swap/lend/borrow). Mainnet
# remains blocked by SHERPA_STAGE_2_ENABLED and startup validation.
SHERPA_STAGE_2_TESTNET_ENABLED=true

# Stage 2 Base Sepolia contracts — testnet audit target, not mainnet
SHERPA_ROUTER_BASE_SEPOLIA=0xDfe689ec2f0Ae3635C372DfaB7b6581bBb7c4032
SHERPA_TREASURY_BASE_SEPOLIA=0x70A58169BF96587E55F500c4b5cb9d956Ef826ee
