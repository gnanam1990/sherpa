# === MAINNET CONFIGURATION ===
# Copy to .env.mainnet and fill in values

# Chain
SHERPA_CHAIN=base-mainnet

# Database
DATABASE_URL=
SUPABASE_SERVICE_KEY=
SHERPA_USE_REAL_DB=true

# Paymaster (Mainnet)
SHERPA_PAYMASTER_RPC=

# Protocol Addresses (Mainnet)
# Confirm protocol addresses against upstream docs before enabling mainnet.
AERODROME_ROUTER_ADDRESS=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
AAVE_DATA_PROVIDER_ADDRESS=

# Fee Configuration
SHERPA_FEE_ENABLED=true
SHERPA_FEE_BPS=10
SHERPA_FEE_TREASURY_ADDRESS=

# Simulation (fail-closed on mainnet)
SHERPA_SIMULATION_ENABLED=true
SHERPA_SIMULATION_FAIL_OPEN=false

# Tenderly
TENDERLY_API_KEY=
TENDERLY_USER=
TENDERLY_PROJECT=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Admin
ADMIN_API_KEY=
CRON_SECRET=

# Identity
NEYNAR_API_KEY=
