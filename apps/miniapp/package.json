{
  "name": "@sherpa/miniapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "pnpm --filter @sherpa/ui --filter @sherpa/core --filter @sherpa/memory --filter @sherpa/tools build && next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@coinbase/onchainkit": "1.1.2",
    "@farcaster/frame-sdk": "^0.2.0",
    "@sherpa/core": "workspace:*",
    "@sherpa/memory": "workspace:*",
    "@sherpa/tools": "workspace:*",
    "@sherpa/ui": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.0.0",
    "wagmi": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
